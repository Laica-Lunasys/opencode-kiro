{
  "name": "@laica-lunasys/opencode-kiro",
  "version": "0.1.0",
  "private": true,
  "description": "Amazon Kiro models in OpenCode V2 via the official Kiro CLI ACP interface",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laica-Lunasys/opencode-kiro.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "kiro-acp-ai-provider": "3.2.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.16",
    "@types/node": "^20.19.42",
    "typescript": "^5.7.0"
  }
}
